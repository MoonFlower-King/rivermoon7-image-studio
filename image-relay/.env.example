# Image Relay example configuration.
# Copy this file to .env and fill values for your own deployment.

# OpenAI-compatible upstream endpoint. For NewAPI in Docker, this is often
# http://new-api:3000/v1 or http://host.docker.internal:3000/v1.
UPSTREAM_BASE_URL=http://new-api:3000/v1

# Optional non-/v1 base used for metadata endpoints.
# Leave empty to derive it from UPSTREAM_BASE_URL.
NEWAPI_API_BASE_URL=

# Public model names exposed to clients.
EXTERNAL_MODEL=image2.0
EXTERNAL_4K_MODEL=image2.0-4k

# Internal upstream model that your NewAPI channel maps to.
INTERNAL_MODEL=gpt-image-2

# Optional fallback API key. In normal user-key passthrough mode, leave this
# empty so the client-provided NewAPI key is used.
UPSTREAM_API_KEY=

PORT=8320
MAX_BODY_BYTES=20971520
REQUEST_TIMEOUT_SECONDS=600
IMAGE_REQUEST_TIMEOUT_SECONDS=1200
IMAGE_RETRY_ATTEMPTS=2
IMAGE_JOB_TTL_SECONDS=1800
